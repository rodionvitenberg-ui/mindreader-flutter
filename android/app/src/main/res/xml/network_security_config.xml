<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds enforce HTTPS-only transport. Cleartext HTTP for local LAN
     workers is enabled exclusively in android/app/src/debug/res/xml/. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
