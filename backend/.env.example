DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://tarot:tarot-dev@127.0.0.1:55432/tarot
CORS_ALLOWED_ORIGINS=https://app.soshallitbe.cyou,https://soshallitbe.cyou
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.soshallitbe.cyou,https://soshallitbe.cyou
TRUST_PROXY_HTTPS=true

# Email / receipts
EMAIL_VERIFICATION_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=tarot@example.invalid

# AI Gateway allow-lists (if configuring providers via Django Admin)
AI_ALLOWED_HOSTS=
AI_VISION_ALLOWED_HOSTS=
AI_ORACLE_ALLOWED_HOSTS=

# Single DeepSeek API key powers Vision (deepseek-flash), Oracle LLM (deepseek-chat) & Voice ASR (/v1/tools/asr)
DEEPSEEK_API_KEY=

# Optional overrides (all default to DeepSeek when DEEPSEEK_API_KEY is set)
VISION_VLM_URL=https://api.deepseek.com/v1/chat/completions
VISION_VLM_API_KEY=
VISION_VLM_MODEL=deepseek-flash
VISION_VLM_TIMEOUT=25.0

ORACLE_LLM_URL=https://api.deepseek.com/v1/chat/completions
ORACLE_LLM_API_KEY=
ORACLE_LLM_MODEL=deepseek-chat
ORACLE_LLM_TIMEOUT=25.0

# Optional dedicated Whisper STT override (leave blank to auto-use DeepSeek ASR /v1/tools/asr)
STT_API_URL=
STT_API_KEY=
STT_API_MODEL=whisper-large-v3

# Server-enforced daily AI quotas (Free vs PRO)
ORACLE_FREE_DAILY_LIMIT=15
ORACLE_PRO_DAILY_LIMIT=300
STT_FREE_DAILY_LIMIT=25
STT_PRO_DAILY_LIMIT=300

# Telegram Mini App & Reminder Bot (Phase E)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINIAPP_URL=https://app.soshallitbe.cyou/

# PRO Solana payments & owner alerts
PRO_SOLANA_WALLET=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PRO_OWNER_NOTIFY_EMAIL=
PRO_OWNER_TELEGRAM_BOT_TOKEN=
PRO_OWNER_TELEGRAM_CHAT_ID=

# Local dev payment sandbox (disabled in production)
PAYMENTS_ENABLE_DEV=false
PAYMENTS_DEV_WEBHOOK_SECRET=
